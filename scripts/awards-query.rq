SELECT ?film ?tmdb ?imdb ?awardLabel ?date ?pub WHERE {
  { ?film p:P166 ?st . ?st ps:P166 ?award . }
  UNION
  { ?person p:P166 ?st . ?st ps:P166 ?award ; pq:P1686 ?film . }
  ?film wdt:P4947 ?tmdb .
  ?award rdfs:label ?awardLabel . FILTER(LANG(?awardLabel) = "en")
  FILTER(STRSTARTS(?awardLabel, "Golden Globe Award") || STRSTARTS(?awardLabel, "Academy Award for"))
  OPTIONAL { ?film wdt:P345 ?imdb . }
  OPTIONAL { ?st pq:P585 ?date . }
  OPTIONAL { ?film wdt:P577 ?pub . }
}
